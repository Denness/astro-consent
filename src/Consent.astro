---
// Put once in <head>, before anything else that calls gtag().
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import { deferredTagLoader, headScript } from './headScript';
import type { ClientConfig, ConsentProps } from './types';

type Props = ConsentProps;

const {
  gaId,
  adsId,
  clarityId,
  privacyUrl,
  contactUrl,
  revision = 1,
  pageViewsOnNavigation = false,
  loadTag = 'immediately',
  theme = {},
  enabled = import.meta.env.PROD,
} = Astro.props;

const analytics = Boolean(gaId || clarityId);
const marketing = Boolean(adsId);
const active = enabled && (analytics || marketing);

// gtag.js takes one id in its URL; the others are attached with gtag('config').
const loaderId = gaId || adsId;

const clientConfig: ClientConfig = {
  analytics,
  marketing,
  services: { ga: Boolean(gaId), ads: Boolean(adsId), clarity: Boolean(clarityId) },
  privacyUrl,
  contactUrl,
  revision,
};

const themeCss = Object.keys(theme).length
  ? `#cc-main{${Object.entries(theme)
      .map(([key, value]) => `--cc-${key}:${value}`)
      .join(';')}}`
  : '';
---

{
  active && (
    <>
      {loaderId && loadTag === 'immediately' && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${loaderId}`} />
      )}
      <script is:inline set:html={headScript({ gaId, adsId, clarityId, revision, pageViewsOnNavigation })} />
      <script
        is:inline
        type="application/json"
        id="astro-consent-config"
        set:html={JSON.stringify(clientConfig).replace(/</g, '\\u003c')}
      />
      {loaderId && loadTag === 'on-interaction' && <script is:inline set:html={deferredTagLoader(loaderId)} />}
      {themeCss && <style is:inline set:html={themeCss} />}
    </>
  )
}

<script>
  // Does nothing unless the config above was rendered.
  import { start } from './client';
  start();
</script>

<style is:global>
  /* vanilla-cookieconsent stacks the bar's buttons under 640px with !important, turning
     the bar into a half-screen sheet on phones. Keep them in one wrapping row instead. */
  @media screen and (max-width: 640px) {
    #cc-main .cm--bar .cm__btns,
    #cc-main .cm--bar .cm__btn-group {
      flex-direction: row !important;
      flex-wrap: wrap;
      gap: 0.375rem;
    }
    #cc-main .cm--bar .cm__btn + .cm__btn,
    #cc-main .cm--bar .cm__btn-group + .cm__btn-group {
      margin: 0 !important;
    }
    #cc-main .cm--bar .cm__btn {
      flex: 1 1 auto !important;
      min-width: 0;
    }
    #cc-main .cm--bar .cm__btn-group:last-child {
      flex: 1 1 100%;
    }
  }
</style>
